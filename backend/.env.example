PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=feelingtrip_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/feelingtrip_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_STORAGE_BUCKET=feelingtrip-media

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Third-party APIs
GEMINI_API_KEY=your_google_gemini_api_key
GOONG_MAP_API_KEY=your_goong_map_api_key
FPT_AI_API_KEY=your_fpt_ai_api_key

# VietQR / PayOS / SePay Configuration (Optional)
PAYOS_CLIENT_ID=your_client_id
PAYOS_API_KEY=your_api_key
PAYOS_CHECKSUM_KEY=your_checksum_key
SEPAY_API_KEY=your_sepay_api_key
